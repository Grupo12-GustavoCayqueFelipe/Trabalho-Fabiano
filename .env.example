# Django
# Chave já gerada no padrão do Django (50 caracteres).
SECRET_KEY=sua-chave-secreta-aqui

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados PostgreSQL (Supabase)
# Pegue em: Supabase > Project Settings > Database > Connection string > URI
# Use a porta 6543 (pooler) se for rodar em serverless; 5432 é a conexão direta.
# Se a senha tiver caracteres especiais (@ : / #), faça URL-encode.

DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Alternativa: variáveis separadas (use uma abordagem ou outra, não as duas)
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432

# Supabase Storage (S3 compatível)
# Pegue em: Supabase > Project Settings > Storage > S3 Access Keys

SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

SUPABASE_S3_ACCESS_KEY=SEU_ACCESS_KEY_ID_AQUI
SUPABASE_S3_SECRET_KEY=SUA_SECRET_ACCESS_KEY_AQUI
SUPABASE_S3_ENDPOINT_URL=https://SEU_PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET_NAME=educontroll-uploads
SUPABASE_S3_REGION=sa-east-1
