# Django settings for the project.

# Chave secreta para criptografia e segurança do projeto.
SECRET_KEY=sua-chave-secreta-forte-aqui

# Configuração do modo DEBUG para desenvolvimento.
DEBUG=True

# Configuração do banco de dados PostgreSQL.
DATABASE_URL=postgresql://usuario:senha@host:5432/educontroll

# Configuração do Supabase para armazenamento de arquivos.
SUPABASE_URL=https://<referencia-do-projeto>.supabase.co
SUPABASE_S3_ACCESS_KEY=seu_access_key_id_aqui
SUPABASE_S3_SECRET_KEY=sua_secret_access_key_aqui
SUPABASE_S3_ENDPOINT_URL=https://<referencia-do-projeto>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET_NAME=educontroll-uploads
SUPABASE_S3_REGION=sa-east-1